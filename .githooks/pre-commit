#!/bin/bash
#
# Pre-commit hook for mod_edukami
#
# Performs the following checks before allowing a commit:
# 1. Lints all staged PHP files for syntax errors
# 2. Checks that translation strings are present in both English and Spanish
#
# To install this hook, run from the repository root:
#   git config core.hooksPath .githooks
#
# Or copy/symlink this file to .git/hooks/pre-commit

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Track if we have errors
ERRORS=0

# ============================================================================
# PHP Syntax Lint Check
# ============================================================================

# Get list of staged PHP files
PHP_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$')

if [ -n "$PHP_FILES" ]; then
    echo -e "${YELLOW}Linting PHP files...${NC}"

    # Check if PHP is available
    if ! command -v php &> /dev/null; then
        echo -e "${YELLOW}Warning: PHP not found in PATH, skipping PHP lint.${NC}"
    else
        LINT_ERRORS=0

        for FILE in $PHP_FILES; do
            # Only check files that exist (not deleted)
            if [ -f "$REPO_ROOT/$FILE" ]; then
                # Run PHP lint and capture output
                OUTPUT=$(php -l "$REPO_ROOT/$FILE" 2>&1)
                RESULT=$?

                if [ $RESULT -ne 0 ]; then
                    if [ $LINT_ERRORS -eq 0 ]; then
                        echo -e "${RED}PHP syntax errors found:${NC}"
                    fi
                    echo -e "${RED}  ✗ $FILE${NC}"
                    echo "$OUTPUT" | grep -v "^No syntax errors" | sed 's/^/    /'
                    LINT_ERRORS=1
                fi
            fi
        done

        if [ $LINT_ERRORS -eq 0 ]; then
            echo -e "${GREEN}✓ All PHP files passed syntax check${NC}"
        else
            ERRORS=1
        fi
    fi
    echo ""
fi

# ============================================================================
# Translation Sync Check
# ============================================================================

# Check if any language files are being committed
LANG_FILES=$(git diff --cached --name-only | grep -E '^lang/(en|es)/edukami\.php$')

if [ -n "$LANG_FILES" ]; then
    echo -e "${YELLOW}Checking translations...${NC}"

    # Check if PHP is available
    if ! command -v php &> /dev/null; then
        echo -e "${YELLOW}Warning: PHP not found in PATH, skipping translation check.${NC}"
        echo "Run 'php scripts/check_translations.php' manually to verify translations."
    else
        # Run the translation check
        if [ -f "$REPO_ROOT/scripts/check_translations.php" ]; then
            php "$REPO_ROOT/scripts/check_translations.php"
            if [ $? -ne 0 ]; then
                ERRORS=1
            fi
        else
            echo -e "${YELLOW}Warning: Translation check script not found.${NC}"
        fi
    fi
    echo ""
fi

# ============================================================================
# Final Result
# ============================================================================

if [ $ERRORS -ne 0 ]; then
    echo -e "${RED}Commit aborted. Please fix the issues above.${NC}"
    exit 1
fi

exit 0
