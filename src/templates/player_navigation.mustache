{{!
    @template mod_skilland/player_navigation

    A plain previous / next lesson row for the (non fullscreen) player. A neighbour
    that cannot be played leaves an empty placeholder so the next link keeps its place.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * prev - The previous playable lesson, false when there is none:
      * url - Its player link.
      * text - Its code and title, already formatted by format_string().
    * next - The next playable lesson, false when there is none (same shape as prev).

    Example context (json):
    {
        "prev": {
            "url": "https://moodle.example/mod/skilland/view.php?id=2&play=10",
            "text": "L1.1 - What is testing?"
        },
        "next": false
    }
}}
<div class="skilland-player-nav">
    {{#prev}}
    <a href="{{url}}" class="skilland-nav-prev">← {{{text}}}</a>
    {{/prev}}
    {{^prev}}
    <span class="skilland-nav-prev"></span>
    {{/prev}}
    {{#next}}
    <a href="{{url}}" class="skilland-nav-next">{{{text}}} →</a>
    {{/next}}
    {{^next}}
    <span class="skilland-nav-next"></span>
    {{/next}}
</div>
