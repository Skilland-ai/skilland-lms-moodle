{{!
    @template mod_skilland/mobile_view

    The Moodle App page of a Skilland activity: the lessons with the viewer's progress, each
    playable lesson linking to the app's native SCORM player (Ionic markup, compiled by the app).

    The lesson fields are the ones mod_skilland/lesson_list exports, with app player links.
    core-link capture="true" keeps a link inside the app, so the SCORM player link handler
    opens it instead of the browser.

    The app compiles this template as Angular code, so user-controlled text (the intro and the
    lesson titles) arrives with its braces and @ as HTML entities (skilland_app_template_text()).

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * cmid - The course module id.
    * notprovisioned - Whether the topic SCORM is not provisioned yet (nothing to play).
    * intro - The formatted activity description, Angular-safe, empty when there is none.
    * lastupdated - The "Content last updated" notice, empty when the content was never rebuilt.
    * haslessons - Whether the activity has any visible lesson.
    * hassummary - Whether the progress summary and the Continue button are shown (a playable lesson exists).
    * summarytext - The "3 of 8 lessons completed" line.
    * percent - The completed share of the playable lessons, 0 to 100.
    * progressbarlabel - The accessible name of the progress bar.
    * continuemode - start, continue or review.
    * continuetext - The label of the Continue / Start / Review button.
    * continueurl - The app player link the button opens.
    * lessons - The lessons, in order:
      * playable - Whether the lesson opens in the SCORM player.
      * url - The app player link of a playable lesson.
      * showlabel - Whether the lesson code badge is shown.
      * label - The lesson code, like L1.2.
      * title - The lesson title, formatted by format_string() and made Angular-safe.
      * meta - The updated date and score line, empty when there is neither.
      * statustext - The progress status.
      * helptext - Why the lesson is unavailable, empty for a playable lesson.
      * istarget - Whether this is the lesson the button opens.

    Example context (json):
    {
        "cmid": 2,
        "notprovisioned": false,
        "intro": "<p>Testing basics</p>",
        "lastupdated": "Content last updated: 27/09/26, 10:00. Any update to this activity resets progress on it.",
        "haslessons": true,
        "hassummary": true,
        "summarytext": "1 of 2 lessons completed",
        "percent": 50,
        "progressbarlabel": "Lessons completed: 1 of 2",
        "continuemode": "continue",
        "continuetext": "Continue",
        "continueurl": "https://moodle.example/mod/scorm/player.php?id=40&scoid=111&mode=normal&newattempt=off&courseid=3",
        "lessons": [
            {
                "playable": true,
                "url": "https://moodle.example/mod/scorm/player.php?id=40&scoid=110&mode=normal&newattempt=off&courseid=3",
                "showlabel": true,
                "label": "L1.1",
                "title": "What is testing?",
                "meta": "Updated: 27/09/26 · Score: 80%",
                "statustext": "Completed",
                "helptext": "",
                "istarget": false
            },
            {
                "playable": false,
                "url": "",
                "showlabel": true,
                "label": "L1.2",
                "title": "Writing a first test",
                "meta": "",
                "statustext": "Not yet available",
                "helptext": "This lesson hasn't been published or synced to Moodle yet.",
                "istarget": false
            }
        ]
    }
}}
<div class="mod_skilland-mobile-view">
    {{#intro}}
    <ion-card>
        <ion-card-content>
            <core-format-text text="{{intro}}" component="mod_skilland" componentId="{{cmid}}"></core-format-text>
        </ion-card-content>
    </ion-card>
    {{/intro}}
    {{#notprovisioned}}
    <ion-card>
        <ion-card-content>{{#str}}content_being_prepared, mod_skilland{{/str}}</ion-card-content>
    </ion-card>
    {{/notprovisioned}}
    {{^notprovisioned}}
    {{#lastupdated}}
    <ion-card>
        <ion-card-content>{{lastupdated}}</ion-card-content>
    </ion-card>
    {{/lastupdated}}
    {{^haslessons}}
    <ion-card>
        <ion-card-content>{{#str}}no_lessons_configured, mod_skilland{{/str}}</ion-card-content>
    </ion-card>
    {{/haslessons}}
    {{#haslessons}}
    {{#hassummary}}
    <ion-item class="ion-text-wrap" lines="none">
        <ion-label>
            <p>{{summarytext}}</p>
            <core-progress-bar progress="{{percent}}" a11yText="{{progressbarlabel}}"></core-progress-bar>
        </ion-label>
    </ion-item>
    <div class="ion-padding">
        <ion-button expand="block" core-link capture="true" href="{{continueurl}}" data-mode="{{continuemode}}">{{continuetext}}</ion-button>
    </div>
    {{/hassummary}}
    <ion-list>
        <ion-list-header>
            <ion-label>{{#str}}lessons, mod_skilland{{/str}}</ion-label>
        </ion-list-header>
        {{#lessons}}
        {{#playable}}
        <ion-item button="true" detail="true" class="ion-text-wrap" core-link capture="true" href="{{url}}">
            {{#showlabel}}
            <ion-badge slot="start" color="light">{{label}}</ion-badge>
            {{/showlabel}}
            <ion-label>
                <h2>{{{title}}}</h2>
                {{#meta}}
                <p>{{meta}}</p>
                {{/meta}}
                <p>{{#istarget}}<strong>{{statustext}}</strong>{{/istarget}}{{^istarget}}{{statustext}}{{/istarget}}</p>
            </ion-label>
        </ion-item>
        {{/playable}}
        {{^playable}}
        <ion-item class="ion-text-wrap" disabled="true">
            {{#showlabel}}
            <ion-badge slot="start" color="light">{{label}}</ion-badge>
            {{/showlabel}}
            <ion-label>
                <h2>{{{title}}}</h2>
                {{#meta}}
                <p>{{meta}}</p>
                {{/meta}}
                <p>{{statustext}}</p>
                {{#helptext}}
                <p>{{helptext}}</p>
                {{/helptext}}
            </ion-label>
        </ion-item>
        {{/playable}}
        {{/lessons}}
    </ion-list>
    {{/haslessons}}
    {{/notprovisioned}}
</div>
