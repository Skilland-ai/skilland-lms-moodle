{{!
    @template mod_skilland/fullscreen_navigation

    The previous / next lesson bar at the bottom of the fullscreen player
    (a partial of mod_skilland/player). A neighbour that cannot be played is
    rendered disabled, with its state spelled out for screen readers.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * prev - The previous playable lesson, false when there is none:
      * url - Its player link.
      * text - Its code and title, already formatted by format_string().
      * arialabel - The accessible name of the link.
    * next - The next playable lesson, false when there is none (same shape as prev).

    Example context (json):
    {
        "prev": false,
        "next": {
            "url": "https://moodle.example/mod/skilland/view.php?id=2&play=11",
            "text": "L1.2 - Writing a first test",
            "arialabel": "Next lesson: L1.2 - Writing a first test"
        }
    }
}}
<div class="skilland-fullscreen-nav">
    {{#prev}}
    <a href="{{url}}" class="skilland-fullscreen-nav-prev" aria-label="{{arialabel}}"><span class="skilland-fullscreen-nav-arrow" aria-hidden="true">←</span><span class="skilland-fullscreen-nav-text">{{{text}}}</span></a>
    {{/prev}}
    {{^prev}}
    <span class="skilland-fullscreen-nav-prev skilland-fullscreen-nav-disabled" aria-disabled="true"><span class="visually-hidden">{{#str}}no_previous_lesson, mod_skilland{{/str}}</span></span>
    {{/prev}}
    {{#next}}
    <a href="{{url}}" class="skilland-fullscreen-nav-next" aria-label="{{arialabel}}"><span class="skilland-fullscreen-nav-text">{{{text}}}</span><span class="skilland-fullscreen-nav-arrow" aria-hidden="true">→</span></a>
    {{/next}}
    {{^next}}
    <span class="skilland-fullscreen-nav-next skilland-fullscreen-nav-disabled" aria-disabled="true"><span class="visually-hidden">{{#str}}no_next_lesson, mod_skilland{{/str}}</span></span>
    {{/next}}
</div>
