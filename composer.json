{
    "name": "mod_skilland/moodle-plugin",
    "description": "Moodle plugin for Skilland integration",
    "type": "moodle-mod",
    "require": {
        "php": ">=8.1",
        "firebase/php-jwt": "^6.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "mod_skilland\\": "classes/"
        }
    },
    "config": {
        "audit": {
            "block-insecure": false
        }
    }
}
